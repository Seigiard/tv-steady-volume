<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:background="@color/panel_bg">

    <LinearLayout
        android:id="@+id/tiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tile_off"
            style="@style/Tile"
            android:text="@string/preset_off" />

        <TextView
            android:id="@+id/tile_light"
            style="@style/Tile"
            android:text="@string/preset_light" />

        <TextView
            android:id="@+id/tile_auto"
            style="@style/Tile"
            android:text="@string/preset_auto" />

        <TextView
            android:id="@+id/tile_night"
            style="@style/Tile"
            android:text="@string/preset_night" />
    </LinearLayout>

    <TextView
        android:id="@+id/tile_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:textColor="@color/text_dim" />

    <TextView
        android:id="@+id/boost_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="22sp"
        android:textColor="@color/text" />

    <SeekBar
        android:id="@+id/boost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:padding="20dp"
        android:background="@drawable/row"
        android:focusable="true" />

    <!-- Settings is the source of truth; restored state must not write through this listener. -->
    <CheckBox
        android:id="@+id/speech"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@drawable/row"
        android:focusable="true"
        android:saveEnabled="false"
        android:text="@string/speech"
        android:textSize="22sp"
        android:textColor="@color/text" />
</LinearLayout>
